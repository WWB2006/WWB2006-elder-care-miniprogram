.service__search {
  display: flex;
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
}

.service__input {
  flex: 1;
  min-height: var(--size-touch-min);
  padding: 0 var(--space-md);
  font-size: var(--font-size-body);
  color: var(--color-text-primary);
  background-color: var(--color-bg-card);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
}

.service__placeholder {
  color: var(--color-text-tertiary);
}

.service__search-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 160rpx;
  min-height: var(--size-touch-min);
  font-size: var(--font-size-body);
  font-weight: 600;
  color: var(--color-text-inverse);
  background-color: var(--color-primary);
  border-radius: var(--radius-md);
}

.service__search-btn--hover {
  background-color: var(--color-primary-dark);
}

/* 清空按钮：触控区保持最小尺寸，避免老人点不中 */
.service__clear {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: var(--size-touch-min);
  min-height: var(--size-touch-min);
  font-size: var(--font-size-heading);
  color: var(--color-text-tertiary);
  background-color: var(--color-bg-card);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
}

.service__clear--hover {
  background-color: var(--color-bg-page);
}

.service__cats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--space-sm);
  margin-bottom: var(--space-md);
}

.service__cat {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--space-xs);
  padding: var(--space-sm) 0;
  background-color: var(--color-bg-card);
  border: 4rpx solid transparent;
  border-radius: var(--radius-md);
}

.service__cat--hover {
  opacity: 0.85;
}

/* 选中态不只靠颜色：加边框 + 加粗文字 */
.service__cat--active {
  border-color: var(--color-primary);
  background-color: var(--color-primary-light);
}

.service__cat-label {
  font-size: var(--font-size-caption);
  color: var(--color-text-primary);
}

.service__cat--active .service__cat-label {
  font-weight: 700;
  color: var(--color-primary);
}

.service__item {
  display: flex;
  gap: var(--space-md);
}

.service__item--hover {
  opacity: 0.92;
}

.service__cover {
  flex-shrink: 0;
  width: 200rpx;
  height: 200rpx;
  background-color: var(--color-border);
  border-radius: var(--radius-sm);
}

.service__body {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
}

.service__name {
  font-size: var(--font-size-title);
  font-weight: 600;
  color: var(--color-text-primary);
}

.service__org {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
}

.service__meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.service__price {
  font-size: var(--font-size-title);
  font-weight: 700;
  color: var(--color-accent);
}

.service__sold {
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
}

.service__more {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--size-button-lg);
  margin-top: var(--space-md);
  font-size: var(--font-size-body);
  color: var(--color-text-link);
  background-color: var(--color-primary-light);
  border-radius: var(--radius-md);
}

.service__more--hover {
  opacity: 0.85;
}

.service__more--loading {
  color: var(--color-text-tertiary);
}

.service__end {
  display: block;
  padding: var(--space-lg) 0;
  font-size: var(--font-size-caption);
  color: var(--color-text-tertiary);
  text-align: center;
}

.service__skeleton {
  display: flex;
  flex-direction: column;
  gap: var(--space-md);
}

.service__skeleton-item {
  height: 200rpx;
}
