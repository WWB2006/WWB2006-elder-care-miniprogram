.nb {
  position: relative;
  width: 100%;
  color: var(--color-text-primary);
  background-color: var(--color-bg-card);
}

.nb--primary {
  color: var(--color-text-inverse);
  background-color: var(--color-primary);
}

.nb__bar {
  position: relative;
  display: flex;
  align-items: center;
  padding: 0 var(--space-sm);
}

.nb__back {
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: var(--size-touch-min);
  padding: 0 var(--space-sm);
}

.nb__back--hover {
  opacity: 0.7;
}

.nb__back-icon {
  font-size: 52rpx;
  line-height: 1;
}

.nb__back-text {
  font-size: var(--font-size-body);
}

.nb__title-wrap {
  position: absolute;
  left: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  transform: translateX(-50%);
}

.nb__title {
  font-size: var(--font-size-title);
  font-weight: 600;
}

.nb__subtitle {
  font-size: var(--font-size-caption);
  opacity: 0.85;
}
