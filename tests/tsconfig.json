{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2020",
    "types": ["jest", "node", "miniprogram-api-typings"],
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["./**/*.ts", "../miniprogram/**/*.ts", "../typings/**/*.d.ts"]
}
